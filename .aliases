# Strip whitespace
alias wstrip="sed 's/[\n ]//g'"
alias fiddle="sudo tcpdump -s 1024 -l -A dst"
alias detach-monitor="xrandr --output DP1 --off"

alias d="docker compose"
alias dl="docker compose logs --tail=1000 -f"
alias ls="ls --color=auto"
alias ll="ls -lh"
alias la="ls -lha"
alias ai="sudo apt-get update && sudo apt-get install -y $@"
# better git diff.
alias gdiff="git diff --word-diff -w"
# recap on work done lately
alias recap="git log --all --oneline --no-merges --author=clark@countable.ca"
# what have i done today?
alias todayswork="git log --since=00:00:00 --all --no-merges --oneline --author=clark@countable.ca"
# make a changelog
alias changelog="git log --oneline --no-merges <last tag>..HEAD"
# analyze complicated logs
alias forensic="git log --graph --all --decorate --stat --date=iso"
# remove alread-merged remote branches
alias git_cleanup_remote="git fetch --all && git remote prune origin && git branch -r --merged | grep -v master | grep -v develop | sed 's/origin\///' | xargs -n 1 git push --delete origin"

# --- Cortico parallel-checkout nav ---
# k1/k2/k3 jump to kmc_shifts in cortico/cortico2/cortico3.
# w1/w2/w3 jump to cortico-website in cortico/cortico2/cortico3.
# If running as clark, switches to the claude account first (matches clark's
# usual "cd then sudo su claude" muscle memory) and lands in the target dir.
_gotree() {
  if [ "$USER" = "clark" ]; then
    sudo su claude -c "cd $1 && exec zsh"
  else
    cd "$1"
  fi
}
k1() { _gotree /home/claude/cortico/kmc_shifts }
k2() { _gotree /home/claude/cortico2/kmc_shifts }
k3() { _gotree /home/claude/cortico3/kmc_shifts }
w1() { _gotree /home/claude/cortico/cortico-website }
w2() { _gotree /home/claude/cortico2/cortico-website }
w3() { _gotree /home/claude/cortico3/cortico-website }

alias safeclaude="docker run -it --network host -v $(pwd):/workspace -v devcontainer:/home/node -v /var/run/docker.sock:/var/run/docker.sock safeclaude claude --dangerously-skip-permissions"

