#!/bin/zsh
# push — push current branch with --no-verify, after first merging in
# the latest from the branch's detected base.
#
# Detected base = whichever of origin/{develop,master,release} has the
# most-recent merge-base with HEAD (i.e. the branch you most recently
# cut from). Skips the merge if:
#   - working tree is dirty (warns)
#   - we're on a base branch ourselves
#   - no base detectable (warns)
# Pushes regardless.

branch=$(git branch --show-current)
if [ -z "$branch" ]; then
  echo "push: detached HEAD" >&2
  exit 1
fi

update_from_base() {
  if [ -n "$(git status --porcelain)" ]; then
    echo "push: dirty tree — skipping base update"
    return
  fi
  case "$branch" in
    develop|master|release)
      echo "push: on base branch — skipping update"
      return
      ;;
  esac

  local best_base="" best_ts=0
  for cand in develop master release; do
    git show-ref --verify --quiet "refs/remotes/origin/$cand" || continue
    local sha; sha=$(git merge-base HEAD "origin/$cand" 2>/dev/null) || continue
    [ -z "$sha" ] && continue
    local ts; ts=$(git log -1 --format=%ct "$sha" 2>/dev/null) || continue
    if [ "$ts" -gt "$best_ts" ]; then best_ts=$ts; best_base=$cand; fi
  done

  if [ -z "$best_base" ]; then
    echo "push: no base detected — no update made"
    return
  fi

  echo "→ fetching + merging origin/$best_base"
  git fetch --quiet origin "$best_base"
  local before after
  before=$(git rev-parse HEAD)
  if ! git merge --no-verify --quiet "origin/$best_base"; then
    echo "✗ merge failed — push aborted" >&2
    exit 1
  fi
  after=$(git rev-parse HEAD)
  if [ "$before" = "$after" ]; then
    echo "  ✓ already up to date with origin/$best_base"
  else
    echo "  ✓ $branch ← origin/$best_base: +$(git rev-list --count "$before..$after") commits"
  fi
}

update_from_base
git push --no-verify origin "$branch" "$@"
