#!/usr/bin/env bash
set -euxo pipefail

# Determine input file
INPUT="${1:-}"

if [[ -z "$INPUT" ]]; then
  if [[ -f "db.sql.zst" ]]; then
    INPUT="db.sql.zst"
  elif [[ -f "db.sql" ]]; then
    INPUT="db.sql"
  else
    echo "Error: No input file provided and db.sql(.zst) not found." >&2
    exit 1
  fi
fi

# Detect compose command
if command -v docker >/dev/null 2>&1; then
  if docker compose version >/dev/null 2>&1; then
    dc="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    dc="docker-compose"
  else
    echo "Docker found, but no compose support detected"
    exit 1
  fi

elif command -v podman >/dev/null 2>&1; then
  if podman compose version >/dev/null 2>&1; then
    dc="podman compose"
  elif command -v podman-compose >/dev/null 2>&1; then
    dc="podman-compose"
  else
    echo "Podman found, but no compose support detected"
    exit 1
  fi

else
  echo "Neither docker nor podman found"
  exit 1
fi

echo "Using compose command: $dc"

# Restart db container
$dc stop
$dc up -d db

sleep 2

# Recreate database
$dc exec db dropdb -U postgres postgres || true
$dc exec db createdb -U postgres postgres

# Speed up restore
$dc exec -T db psql -U postgres -c \
  "ALTER SYSTEM SET synchronous_commit = 'off';"

$dc exec -T db psql -U postgres -c \
  "SELECT pg_reload_conf();"

# Restore dump
if [[ "$INPUT" == *.zst ]]; then
  zstd -dc "$INPUT" | $dc exec -T db psql -U postgres postgres
else
  cat "$INPUT" | $dc exec -T db psql -U postgres postgres
fi

# Restore normal settings
$dc exec -T db psql -U postgres -c \
  "ALTER SYSTEM RESET synchronous_commit;"

$dc exec -T db psql -U postgres -c \
  "SELECT pg_reload_conf();"

# Restart pgbouncer to flush stale connection pool
$dc restart pgbouncer 2>/dev/null || true

echo "Database restore complete"
